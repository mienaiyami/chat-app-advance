{
	"name": "chat-app-advance",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm with-env next dev --turbo",
		"build": "pnpm with-env next build",
		"start": "pnpm with-env next start",
		"format-and-lint": "biome check ./src",
		"format-and-lint:fix": "biome check --write ./src",
		"with-env": "dotenv -e ../../.env --",
		"preview": "pnpm with-env next build && pnpm with-env next start",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.69.0",
		"@trpc/client": "^11.0.0",
		"@trpc/react-query": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"next": "^15.2.3",
		"next-auth": "5.0.0-beta.25",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"server-only": "^0.0.1",
		"socket.io-client": "^4.8.1",
		"superjson": "^2.2.1",
		"zod": "^3.24.2",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@repo/database": "workspace:*",
		"@repo/api": "workspace:*",
		"@repo/auth": "workspace:*"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.0.15",
		"@types/node": "^20.14.10",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"postcss": "^8.5.3",
		"tailwindcss": "^4.0.15",
		"typescript": "^5.8.2",
		"dotenv-cli": "^8.0.0"
	},
	"ct3aMetadata": {
		"initVersion": "7.39.0"
	},
	"packageManager": "pnpm@10.6.3",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"sharp"
		]
	}
}